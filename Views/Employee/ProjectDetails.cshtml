@model Project
@{
    ViewData["Title"] = "Project Details";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Project Details</h1>
            <a asp-action="Projects" class="btn btn-secondary mt-2">Back to Projects</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">@Model.Title</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
                    }
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Category:</strong>
                            <p>@Model.Category</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <p>
                                <span class="badge @(Model.Status switch
                                {
                                    "Active" => "bg-success",
                                    "Completed" => "bg-primary",
                                    "OnHold" => "bg-warning",
                                    "Cancelled" => "bg-danger",
                                    _ => "bg-secondary"
                                })">
                                    @Model.Status
                                </span>
                            </p>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Location:</strong>
                            <p>@Model.Location</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Created:</strong>
                            <p>@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p>@Model.Description</p>
                    </div>
                    
                    <div class="mb-3">
                        <strong>Funding Progress:</strong>
                        <div class="progress mb-2" style="height: 25px;">
                            @{
                                var progress = Model.TargetAmount > 0 ? (Model.RaisedAmount / Model.TargetAmount) * 100 : 0;
                            }
                            <div class="progress-bar bg-success" style="width: @progress%">@progress.ToString("0.0")%</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Raised:</strong> @Model.RaisedAmount.ToString("N2")
                            </div>
                            <div class="col-md-6 text-end">
                                <strong>Target:</strong> @Model.TargetAmount.ToString("N2")
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Start Date:</strong>
                            <p>@Model.StartDate.ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>End Date:</strong>
                            <p>@Model.EndDate?.ToString("dd MMM yyyy") ?? "Ongoing"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Project Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Total Raised:</strong>
                        <p class="h4 text-success">@Model.RaisedAmount.ToString("N2")</p>
                    </div>
                    <div class="mb-3">
                        <strong>Remaining to Target:</strong>
                        <p class="h4 text-warning">@((Model.TargetAmount - Model.RaisedAmount).ToString("N2"))</p>
                    </div>
                    <div class="mb-3">
                        <strong>Progress:</strong>
                        <p class="h4">@progress.ToString("0.0")%</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<Project>
@{
    ViewData["Title"] = "Project Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Project Management</h1>
            <a asp-action="Dashboard" class="btn btn-secondary mt-2">Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">All Projects</h5>
            <a asp-action="CreateProject" class="btn btn-sm btn-light">Create New Project</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Target</th>
                            <th>Raised</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>@project.Title</td>
                                <td>@project.Category</td>
                                <td>@project.Location</td>
                                <td>@project.TargetAmount.ToString("N2")</td>
                                <td>@project.RaisedAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(project.Status switch
                                    {
                                        "Active" => "bg-success",
                                        "Completed" => "bg-primary",
                                        "OnHold" => "bg-warning",
                                        "Cancelled" => "bg-danger",
                                        _ => "bg-secondary"
                                    })">
                                        @project.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="ProjectDetails" asp-route-id="@project.Id" class="btn btn-sm btn-primary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
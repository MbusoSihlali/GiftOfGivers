@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <h1 class="text-center mb-4">Contact Us</h1>
    
    @if (TempData["ContactSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ContactSuccess"]
        </div>
    }
    
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h3 class="card-title mb-4">Get in Touch</h3>
                    <p class="text-muted mb-4">
                        Have questions or want to learn more about how you can help? 
                        Reach out to us and we'll get back to you as soon as possible.
                    </p>
                    
                    <form asp-controller="Home" asp-action="Contact" method="post">
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" class="form-control" id="subject" name="subject" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-lg w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-5">
        <div class="col-md-4 text-center">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📍 Address</h5>
                    <p class="card-text">Gift of the Givers Foundation<br>30 Harding Street<br>Pietermaritzburg, 3201<br>South Africa</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 text-center">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📞 Phone</h5>
                    <p class="card-text">+27 33 342 6600<br>+27 33 345 6800</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 text-center">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">✉️ Email</h5>
                    <p class="card-text">info@giftofthegivers.org<br>donations@giftofthegivers.org</p>
                </div>
            </div>
        </div>
    </div>
</div>
@model VolunteerViewModel
@{
    ViewData["Title"] = "Volunteer Application";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm p-4">
            <h2 class="text-success mb-3">Become a Volunteer</h2>
            <p class="text-muted mb-4">Join our network of humanitarian workers and make a difference in communities across South Africa and beyond.</p>
            
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Province" class="form-label"></label>
                    <input asp-for="Province" class="form-control" />
                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Skills" class="form-label"></label>
                    <input asp-for="Skills" class="form-control" placeholder="e.g., Medical, Logistics, General, Construction" />
                    <span asp-validation-for="Skills" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Availability" class="form-label"></label>
                    <textarea asp-for="Availability" class="form-control" rows="3" placeholder="Describe your availability (weekends, weekdays, emergency deployments, etc.)"></textarea>
                    <span asp-validation-for="Availability" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Motivation" class="form-label"></label>
                    <textarea asp-for="Motivation" class="form-control" rows="4" placeholder="Why do you want to volunteer with Gift of the Givers?"></textarea>
                    <span asp-validation-for="Motivation" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-success w-100">Submit Application</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
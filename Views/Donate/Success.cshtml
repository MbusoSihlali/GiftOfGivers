@model Donation

@{
    ViewData["Title"] = "Donation Success";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card border-success p-4 shadow-sm">
            <div class="text-center border-bottom pb-3 mb-3">
                <h2 class="text-success fw-bold">GIFT OF THE GIVERS FOUNDATION</h2>
                <p class="text-muted">Section 18A Tax Deductible Receipt</p>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Receipt No:</strong> @Model.ReceiptNumber</p>
                    <p><strong>Donor Name:</strong> @Model.DonorName</p>
                    <p><strong>Date Issued:</strong> @Model.CreatedAt.ToString("dd MMMM yyyy")</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p><strong>Amount:</strong> @Model.Currency @Model.Amount.ToString("N2")</p>
                    <p><strong>Type:</strong> @Model.DonationType</p>
                </div>
            </div>

            @if (ViewBag.TaxCertificateJson != null)
            {
                <div class="mt-3">
                    <h5 class="fw-bold text-success">Generated Tax Certificate (Azure Function Response):</h5>
                    <div class="bg-light p-3 border rounded">
                        <pre class="mb-0"><code>@ViewBag.TaxCertificateJson</code></pre>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center mt-3">
                    This is a generated placeholder Section 18A tax certificate for prototype demonstration purposes.
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <button onclick="window.print()" class="btn btn-outline-success w-50">Print / Save as PDF</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary w-50">Return to Home</a>
            </div>
        </div>
    </div>
</div>
@model DonateViewModel
@{
    ViewData["Title"] = "Make a Donation";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm p-4">
            <h2 class="text-success mb-3">Support Disaster Relief</h2>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="DonorName" class="form-label"></label>
                    <input asp-for="DonorName" class="form-control" />
                    <span asp-validation-for="DonorName" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="DonorEmail" class="form-label"></label>
                    <input asp-for="DonorEmail" class="form-control" />
                    <span asp-validation-for="DonorEmail" class="text-danger"></span>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Currency" class="form-label"></label>
                        <select asp-for="Currency" class="form-select">
                            <option value="ZAR">ZAR (R)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                        </select>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="DonationType" class="form-label"></label>
                    <select asp-for="DonationType" class="form-select">
                        <option value="One-Time">One-Time</option>
                        <option value="Recurring">Monthly Recurring</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label asp-for="ProjectId" class="form-label">Allocate to Project (Optional)</label>
                    <select asp-for="ProjectId" class="form-select">
                        <option value="">General Fund</option>
                        @if (Model.Projects != null)
                        {
                            @foreach (var project in Model.Projects)
                            {
                                <option value="@project.Id">@project.Title</option>
                            }
                        }
                    </select>
                </div>
                
                <button type="submit" class="btn btn-success w-100">Complete Donation</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}